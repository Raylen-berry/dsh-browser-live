{
  "name": "dsh-browser-live",
  "version": "0.4.3",
  "description": "看得见的 Agent 浏览器（自研，零外部依赖）：17 个 browser_* 工具直接驱动本机 Chrome/Edge（CDP，含拟人鼠标轨迹），实时观察窗支持内嵌面板与独立网页（/bl/view，可丢副屏/全屏）两种形态、鼠标键盘接管，可配代理与额外启动参数；浮球与观察窗会给设置页/弹层让位，不压内容；登录态持久化在 $DSH_HOME/dsh-browser-live。设计灵感来自 dsh-ego-browser (MIT)。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "browser",
    "cdp",
    "automation",
    "watch-panel"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "test": "node --check index.js && node --check client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.1",
    "react": "^18.2.0"
  },
  "license": "MIT",
  "author": "Raylen-berry"
}
