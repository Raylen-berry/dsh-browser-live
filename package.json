{
  "name": "dsh-browser-live",
  "version": "0.17.0",
  "description": "DSH 浏览器观察窗：操作真实浏览器，实时查看与接管网页任务，可接入日常 Chrome 和 Edge。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "browser",
    "cdp",
    "automation",
    "watch-panel"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "page-read.js",
    "audit.js",
    "bridge.js",
    "client.js",
    "pixdiff.js",
    "extension",
    "tools",
    "docs",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE",
    "view-page.js"
  ],
  "scripts": {
    "test": "node tools/run-all.mjs",
    "audit:check": "node tools/verify-audit-chain.mjs"
  },
  "devDependencies": {
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.2-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.1 <0.3.0",
    "react": "^18.2.0"
  },
  "license": "MIT",
  "author": "Raylen-berry"
}
